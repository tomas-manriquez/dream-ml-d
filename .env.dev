# Ruta interna fija en el contenedor donde se almacenarán los experimentos
EXPERIMENTS_DIR=/workspaces/dream-ml-c/experimentos



# Ruta en el host donde el usuario quiere guardar los experimentos.
# El usuario debe modificar este valor para apuntar a la carpeta deseada (por ejemplo, en Escritorio o Documentos).

HOST_EXPERIMENTS_DIR=/workspaces/dream-ml-c/host_experimentos

# URLs for devcontainer (localhost-based)
VITE_API_URL=http://localhost:8000
VITE_WS_URL=ws://localhost:8000

# MLflow configuration

MLFLOW_UI_URL=http://localhost:5000

#Recuerda invertir las parentésis tal como aparece en el ejemplo.

# ============================================================================
# LSTM REPRODUCIBILITY CONFIGURATION
# ============================================================================
# These environment variables ensure deterministic LSTM training for
# reproducible results across multiple runs with identical configurations.
#
# Core Reproducibility Settings:
PYTHONHASHSEED=42                # Python's internal hash randomization seed
TF_DETERMINISTIC_OPS=1           # TensorFlow deterministic operations
TF_CUDNN_DETERMINISTIC=1         # cuDNN determinism (for future GPU support)

# Single-Threaded CPU Mode (for absolute reproducibility):
# These settings eliminate multi-threading non-determinism at the cost of
# slower training performance. Required for byte-perfect reproducibility.
OMP_NUM_THREADS=1                # OpenMP threads
MKL_NUM_THREADS=1                # Intel MKL threads
OPENBLAS_NUM_THREADS=1           # OpenBLAS threads
NUMEXPR_NUM_THREADS=1            # NumExpr threads
MKL_CBWR=COMPATIBLE              # Reproducibility across Intel/AMD CPUs
#
# NOTE: Single-threading slows down training but ensures 100% reproducibility.
# For production with acceptable ~1-2% variance, you can comment out the
# threading limits above.
# ============================================================================