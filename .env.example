# ============================================================================
# DREAM ML - Production Environment Configuration
# ============================================================================
# This file contains production-ready environment variables for Docker Compose

# Production mode (disable debug features)
DEBUG=0

# Internal container path where experiments are stored
# This maps to the named volume 'experiments' in docker-compose.yml
EXPERIMENTS_DIR=/app/experimentos

# Frontend API URLs (service-based networking in Docker Compose)
# These use Docker's internal DNS to communicate between containers
VITE_API_URL=http://backend:8000
VITE_EXPERIMENTS_DIR=/app/experimentos
VITE_WS_URL=ws://backend:8000

# MLflow configuration
# Port for MLflow tracking server (default: 5000)
# To change: set MLFLOW_PORT=5001 (or other available port)
MLFLOW_PORT=5000
VITE_MLFLOW_PORT=5000
MLFLOW_UI_URL=http://backend:5000