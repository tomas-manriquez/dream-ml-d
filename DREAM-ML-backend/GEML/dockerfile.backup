# Production-optimized Dockerfile for GEML
# Multi-architecture support: linux/amd64, linux/arm64, darwin/arm64
# Python 3.11 for improved performance and security

# ============================================================================
# Stage 1: BUILDER - Compile Cython modules
# ============================================================================
FROM python:3.11-slim AS builder

WORKDIR /app

# Install build dependencies
# gcc, g++, cmake: Required for compiling Cython and C extensions
# git: Required by some Python packages (dvc, etc.)
RUN apt-get update && \
    apt-get install -y --no-install-recommends \
        gcc \
        g++ \
        cmake \
        git \
        build-essential && \
    rm -rf /var/lib/apt/lists/*

# Copy requirements and install Python dependencies
# Using --no-cache-dir to reduce image size
COPY requirements-base.txt .
RUN pip install --no-cache-dir --upgrade pip && \
    pip install --no-cache-dir -r requirements-base.txt

# Install Cython for code compilation
RUN pip install --no-cache-dir Cython

# Copy source code
COPY . .

# Compile protected modules with Cython
# This creates .so files from Python source files
RUN python setup.py build_ext --inplace

# Remove original Python source files of protected modules
# Keep only the compiled .so files for code protection
RUN rm -f api/views.py api/train.py api/data_cleaning.py api/data_encoding.py

# ============================================================================
# Stage 2: FINAL - Production runtime image
# ============================================================================
FROM python:3.11-slim

WORKDIR /app

# Install runtime dependencies
# These are required at runtime per user requirements
RUN apt-get update && \
    apt-get install -y --no-install-recommends \
        gcc \
        g++ \
        cmake \
        git && \
    rm -rf /var/lib/apt/lists/*

# Create non-root user for security
# Using UID 1000 which is standard for first user on most systems
RUN groupadd -r appuser -g 1000 && \
    useradd -r -u 1000 -g appuser -m -s /bin/bash appuser

# Copy Python packages from builder stage (already installed - no need to reinstall)
# This saves significant build time and disk space by avoiding duplicate pip install
COPY --from=builder /usr/local/lib/python3.11/site-packages /usr/local/lib/python3.11/site-packages
COPY --from=builder /usr/local/bin /usr/local/bin

# Copy compiled code and application from builder stage
COPY --from=builder --chown=appuser:appuser /app/ .

# Create directories for persistent data with proper permissions
# Experimentos: ML experiment data, datasets, and results
# MLflow: experiment tracking and artifacts
# Media: user-uploaded files
# Staticfiles: Django static assets
RUN mkdir -p /app/experimentos /app/mlruns /app/media /app/staticfiles && \
    chown -R appuser:appuser /app

# Switch to non-root user
USER appuser

# Expose ports
# 8000: Django application (uvicorn/ASGI)
# 5000: MLflow tracking server
EXPOSE 8000 5000

# Declare volumes for persistent data
# Mount these volumes when running the container to persist data
VOLUME ["/app/experimentos", "/app/mlruns", "/app/media", "/app/staticfiles"]

# Environment variables
# Python optimization flags
ENV PYTHONUNBUFFERED=1 \
    PYTHONDONTWRITEBYTECODE=1 \
    # Pip configuration
    PIP_NO_CACHE_DIR=1 \
    PIP_DISABLE_PIP_VERSION_CHECK=1

# Start Django application via uvicorn
# MLflow is started by Django views as per requirements
CMD ["python", "-m", "uvicorn", "GEML.asgi:application", "--host", "0.0.0.0", "--port", "8000"]

# ============================================================================
# Build Instructions:
# ============================================================================
# For linux/amd64 (Windows, most Linux servers):
#   docker buildx build --platform linux/amd64 -t geml:latest-amd64 .
#
# For linux/arm64 (Linux ARM, Apple Silicon in Linux mode):
#   docker buildx build --platform linux/arm64 -t geml:latest-arm64 .
#
# For local Apple Silicon (Mac M1/M2/M3):
#   docker buildx build --platform linux/arm64 -t geml:latest .
#
# See BUILD_INSTRUCTIONS.md for detailed multi-platform build guide
# ============================================================================
