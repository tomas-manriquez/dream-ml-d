# ============================================
# DREAM ML Frontend - .dockerignore
# ============================================
# Excludes files from Docker build context
# Reduces build time and image size
# ============================================

# Dependencies (will be installed via npm ci)
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# Build output (will be generated during docker build)
dist/
build/
.vite/

# Git
.git/
.gitignore
.gitattributes

# Environment files (use build args instead)
.env
.env.*
!.env.example

# IDE and editor files
.vscode/
.idea/
*.swp
*.swo
*~
.DS_Store

# Testing
coverage/
.nyc_output/
*.test.js
*.spec.js
__tests__/
__mocks__/

# Documentation (not needed in production image)
*.md
!README.md
docs/

# CI/CD
.github/
.gitlab-ci.yml
.travis.yml
azure-pipelines.yml

# Docker
dockerfile.dev
docker-compose*.yml
.dockerignore

# Logs
logs/
*.log

# Temporary files
tmp/
temp/
*.tmp

# OS files
Thumbs.db
.DS_Store

# Misc
.eslintcache
.prettierrc
.editorconfig
