# ============================================
# DREAM ML Frontend - Production Dockerfile
# ============================================
# Multi-stage build optimized for production deployment
# - Stage 1: Build React app with Vite
# - Stage 2: Serve static files with nginx
#
# Supports multi-platform builds:
# - linux/amd64 (Windows, Linux x86_64)
# - linux/arm64 (macOS Apple Silicon, Linux ARM)
#
# Build: docker build -t dream-ml-frontend:latest .
# Run:   docker run -p 5173:80 dream-ml-frontend:latest
# ============================================

# ============================================
# Stage 1: Build Stage
# ============================================
FROM node:18-alpine AS builder

# Set working directory
WORKDIR /app

# Copy package files for dependency installation
# Copying these first allows Docker to cache this layer
COPY package*.json ./

# Install dependencies
# --only=production: Skip devDependencies (but we need them for build)
# Actually, we need devDependencies for Vite build, so use regular npm ci
RUN npm ci && npm cache clean --force

# Copy source code
COPY . .

# Define build arguments for environment variables
# These VITE_ variables are baked into the build at compile time
ARG VITE_API_URL=http://backend:8000
ARG VITE_WS_URL=backend:8000
ARG VITE_EXPERIMENTS_DIR=/app/experimentos

# Set environment variables for the build process
ENV VITE_API_URL=$VITE_API_URL \
    VITE_WS_URL=$VITE_WS_URL \
    VITE_EXPERIMENTS_DIR=$VITE_EXPERIMENTS_DIR

# Build the production bundle
# Output will be in /app/dist
RUN npm run build

# ============================================
# Stage 2: Production Runtime with nginx
# ============================================
FROM nginx:alpine

# Add metadata labels
LABEL maintainer="DREAM ML Team" \
      description="DREAM ML Frontend - Production Build" \
      version="1.0"

# Copy built assets from builder stage
COPY --from=builder /app/dist /usr/share/nginx/html

# Copy custom nginx configuration
COPY nginx.conf /etc/nginx/conf.d/default.conf

# Expose port 80 (nginx default)
# This will be mapped to 5173 externally via docker-compose
EXPOSE 80

# Health check
HEALTHCHECK --interval=30s --timeout=3s --start-period=5s --retries=3 \
    CMD wget --quiet --tries=1 --spider http://localhost/ || exit 1

# Run nginx in foreground
CMD ["nginx", "-g", "daemon off;"]
